@startuml
title Get All Assessment - /api/v1/assessment GET (VIEW_ASSESSMENT)

start

:Controller receives GetAllAssessment request;

:Validate access token;

if (Token valid?) then (Yes)

    :Authorize VIEW_ASSESSMENT permission;

    if (Authorized?) then (Yes)

        :Send GetAllAssessmentQuery to MediatR;

        :GetAllAssessmentHandler executes;

        :Call Assessment Service to get all assessment;

        :Call Assessment Repository to fetch assessment;

        :Map Assessment entity to AssessmentOverviewDto;

        note right
        AssessmentOverviewDto Mapping:
        - Id -> Id
        - Title -> Title
        - Description -> Description
        - PassingMark -> PassingMark
        - DurationMinute -> DurationMinute
        end note

        :Return 200 OK - List of assessment;

    else (No)

        :Return 403 Forbidden - Insufficient permission for VIEW_ASSESSMENT;
        stop

    endif

else (No)

    :Return 401 Unauthorized - Authentication required;
    stop

endif

stop

@enduml
