@startuml
title Get All Users - /api/v1/user GET (VIEW_USER)

start

:Controller receives GetAllUsers request;
note right
  page (default 1)
  pageSize (default 10)
end note

:Validate access token;

if (Token valid?) then (Yes)

    :Authorize VIEW_USER permission;

    if (Authorized?) then (Yes)

        :Send GetUsersQuery to MediatR;

        :GetUsersHandler executes;

        :Call UserService;

        :Call UserRepository;
        
        :Retrieve users from database;

        note right
        Query Filters:
        - Filter by IsDeleted = false
        - Include Person and Roles details
        end note

        if (Data retrieval successful?) then (Yes)

            :Calculate total count;

            :Apply pagination (Skip/Take);

            note right
            Pagination:
            - Skip: (Page - 1) * PageSize
            - Take: PageSize
            end note

            :Map User entities to UserDetailDto;
            note right
              Id              <- User.Id
              FullName        <- User.Person.FullName
              Email           <- User.Person.Email
              MobileNumber    <- User.Person.MobileNumber
              Designation     <- User.Person.Designation
              Gender          <- User.Person.Gender
              CurrentTier     <- User.CurrentTier
              Roles           <- User.UserRoles
              DateCreated     <- User.DateCreated
            end note

            :Return 200 OK - Users retrieved successfully;
            note right
              Body: Data (UserDetailDto[]), Total, Page, PageSize
            end note

        else (No)
            :Return 500 Internal Server Error - Failed to retrieve users;
            stop
        endif

    else (No)
        :Return 403 Forbidden - Insufficient permissions for VIEW_USER;
        stop
    endif

else (No)
    :Return 401 Unauthorized - Authentication required;
    stop
endif

stop
@enduml
