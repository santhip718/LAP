@startuml
title Delete Question By ID - /api/v1/assessment/question/{id} DELETE (MANAGE_ASSESSMENT)

start

:Controller receives DeleteQuestionById request;

note right
Input Field:
- id (Route)
end note

:Validate access token;

if (Token valid?) then (Yes)

    :Authorize MANAGE_ASSESSMENT permission;

    if (Authorized?) then (Yes)

        :Send DeleteQuestionByIdCommand to MediatR;

        :Validate command data;

        if (Validation failed?) then (Yes)

            :Return 400 Bad Request - Validation failed;
            stop

        endif

        :DeleteQuestionByIdHandler executes;

        :Call Assessment Service to get question by ID;

        if (Question exist?) then (Yes)

            :Begin transaction;

            :Call Assessment Service to delete question;

            :Call Assessment Repository to remove question;

            :Commit transaction;

            :Return 200 OK - Question deleted successfully;

        else (No)

            :Return 404 Not Found - Question not found;
            stop

        endif

    else (No)

        :Return 403 Forbidden - Insufficient permission for MANAGE_ASSESSMENT;
        stop

    endif

else (No)

    :Return 401 Unauthorized - Authentication required;
    stop

endif

stop

@enduml
