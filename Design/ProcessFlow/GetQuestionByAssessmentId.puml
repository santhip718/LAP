@startuml
title Get Question By Assessment ID - /api/v1/assessment/{id}/question GET (VIEW_ASSESSMENT)

start

:Controller receives GetQuestionByAssessmentId request;

note right
Input Field:
- id (Route)
end note

:Validate access token;

if (Token valid?) then (Yes)

    :Authorize VIEW_ASSESSMENT permission;

    if (Authorized?) then (Yes)

        :Send GetQuestionByAssessmentIdQuery to MediatR;

        :Validate command data;

        if (Validation failed?) then (Yes)

            :Return 400 Bad Request - Validation failed;
            stop

        endif

        :GetQuestionByAssessmentIdHandler executes;

        :Call Assessment Service to get assessment by ID;

        if (Assessment exist?) then (Yes)

            :Call Assessment Service to get question by assessment ID;

            :Call Assessment Repository to fetch question;

            :Map Question entity to QuestionDto;

            note right
            QuestionDto Mapping:
            - Id -> Id
            - QuestionText -> QuestionText
            - OptionList -> OptionList
            - Answer -> Answer
            - Weight -> Weight
            - QuestionTypeId -> QuestionTypeId
            - MetaTopicId -> MetaTopicId
            end note

            :Return 200 OK - List of question;

        else (No)

            :Return 404 Not Found - Assessment not found;
            stop

        endif

    else (No)

        :Return 403 Forbidden - Insufficient permission for VIEW_ASSESSMENT;
        stop

    endif

else (No)

    :Return 401 Unauthorized - Authentication required;
    stop

endif

stop

@enduml
