@startuml
title Update User - /api/v1/user/{id} PUT (MANAGE_USER)

start

:Controller receives UpdateUser request;
note right
  Id (from route)
  FullName
  MobileNumber
  DesignationId
  GenderId
end note

:Validate access token;

if (Token valid?) then (Yes)

    :Authorize MANAGE_USER permission;

    if (Authorized?) then (Yes)

        :Send UpdateUserCommand to MediatR;

        :Validate command data (FluentValidation);

        if (Validation failed?) then (Yes)
            :Return 400 Bad Request - Validation failed;
            stop
        endif

        :UpdateUserHandler executes;

        :Call UserService;

        :Call UserRepository;
        :Verify user exists;

        if (User exists?) then (Yes)

            :Map UpdateUserRequestDto to User.Person;
            note right
              FullName        -> Person.FullName
              MobileNumber    -> Person.MobileNumber
              DesignationId   -> Person.DesignationId
              GenderId        -> Person.GenderId
            end note

            :Call UserService;
            :Call UserRepository;
            :Update user entity;

            if (Database operation successful?) then (Yes)
                :Call UserService;
                :Call UserRepository;
                :Retrieve updated user with details;

                :Return 200 OK - User updated successfully;
                note right
                  Body: Id, FullName, Email, MobileNumber,
                  Designation, Gender, CurrentTier,
                  Roles, DateCreated
                end note

            else (No)
                :Return 500 Internal Server Error - Failed to update user;
                stop
            endif

        else (No)
            :Return 404 Not Found - User not found;
            stop
        endif

    else (No)

        :Return 403 Forbidden - Insufficient permissions for MANAGE_USER;
        stop

    endif

else (No)
    :Return 401 Unauthorized - Authentication required;
    stop
endif

stop
@enduml
